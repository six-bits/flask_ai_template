            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ORDER_DELIVERING\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/transitions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "transitions"
              ]
            },
            "description": "Advance order status from ORDER_PREPARING to ORDER_DELIVERING."
          },
          "response": []
        },
        {
          "name": "Transition to ORDER_COMPLETED (Terminal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Status is ORDER_COMPLETED\", function () {",
                  "    pm.expect(pm.response.json().order_status).to.eql(\"ORDER_COMPLETED\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ORDER_COMPLETED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/transitions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "transitions"
              ]
            },
            "description": "Advance order status to ORDER_COMPLETED. Converts reserved portions to sold portions."
          },
          "response": []
        },
        {
          "name": "Transition to ORDER_CANCELLED (Terminal)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
