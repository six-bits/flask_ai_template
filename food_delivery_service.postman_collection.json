    {
      "name": "Order Lifecycle Transitions",
      "item": [
        {
          "name": "Transition to ORDER_PREPARING",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Status is ORDER_PREPARING\", function () {",
                  "    pm.expect(pm.response.json().order_status).to.eql(\"ORDER_PREPARING\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ORDER_PREPARING\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}/transitions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}",
                "transitions"
              ]
            },
            "description": "Advance order status from ORDER_ACCEPTED to ORDER_PREPARING."
          },
          "response": []
        },
